# Copy to backend/.env and set values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/primex_nexus
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
APP_TIMEZONE=Europe/Budapest

JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list
CORS_ORIGINS=http://localhost:3000

# Optional: enable cloud speech-to-text
OPENAI_API_KEY=
SPEECH_TRANSCRIBE_MODEL=whisper-1
SPEECH_MAX_FILE_MB=20
# Comma-separated list, e.g. audio/webm,audio/wav,audio/mp4
SPEECH_ALLOWED_MIME=

# Daily/weekly realization snapshots and optional AI evidence summary
REALIZATION_TIMEZONE=Europe/Tirane
REALIZATION_DAILY_ENABLED=true
REALIZATION_DAILY_HOUR=17
REALIZATION_DAILY_MINUTE=10
REALIZATION_AI_ENABLED=false
REALIZATION_AI_MODEL=gpt-5.6-sol
REALIZATION_AI_TIMEOUT_SECONDS=45

# PrimeFlow MCP and dedicated 1H report scheduler
PRIMEFLOW_API_BASE_URL=http://127.0.0.1:8000
PRIMEFLOW_MCP_HOST=0.0.0.0
PRIMEFLOW_MCP_PORT=8010
PRIMEFLOW_MCP_URL=http://127.0.0.1:8010/sse
PRIMEFLOW_EMAIL=
PRIMEFLOW_PASSWORD=
# Optional alternative to email/password (short-lived tokens are not recommended in production)
PRIMEFLOW_ACCESS_TOKEN=
PRIMEFLOW_REPORT_TIMEZONE=Europe/Tirane
PRIMEFLOW_REPORT_RECIPIENTS=130primex.eu@gmail.com,ga@primexeu.com
STD_PRIMEFLOW_API_TOKEN=
# Gmail SMTP (use a Google app password, not the normal account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Weekly Planning Audit Report (Celery worker + Celery Beat)
WEEKLY_PLANNING_AUDIT_ENABLED=true
WEEKLY_PLANNING_AUDIT_TIMEZONE=Europe/Tirane
WEEKLY_PLANNING_AUDIT_RECIPIENTS=130primex.eu@gmail.com,info@primexeu.com,ga@primexeu.com
REPORT_STORAGE_DIR=uploads/reports
REPORT_RETENTION_DAYS=90


